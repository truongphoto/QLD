{
  "manifest_version": 3,
  "name": "TRƯỜNG GPP – Trợ lý CSDL Dược",
  "version": "1.0.9",
  "description": "Tự động điền thông tin chữ và số vào trang đăng ký CSDL Dược. Không tự đính kèm tài liệu, nhập mã xác nhận hoặc bấm Đăng ký.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://csdlduoc.com.vn/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://truongphoto.github.io/*",
        "https://truong-gpp.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "app_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://csdlduoc.com.vn/*"
      ],
      "js": [
        "target_filler.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TRƯỜNG GPP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
